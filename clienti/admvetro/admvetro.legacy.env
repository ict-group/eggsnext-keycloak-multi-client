# Env file da passare al configuratore Docker Compose di IntelliJ
# (campo "Env file", non il campo env_file del container) per lanciare
# docker-compose-test.yml sul ramo legacy WildFly (Keycloak < 17).
#
# Con CLIENT_ID=admvetro + queste variabili, docker-compose-test.yml
# builda da Dockerfile.legacy invece che dal Dockerfile moderno Quarkus.

CLIENT_ID=admvetro
KEYCLOAK_VERSION=11.0.0
KEYCLOAK_DOCKERFILE=Dockerfile.legacy
# Mount in sola lettura su uno staging path: kc-entrypoint-legacy.sh copia da
# qui dentro /opt/jboss/keycloak/themes, cosi' i temi built-in (base/keycloak)
# non vengono cancellati dal mount e il fix del parent puo' scrivere sui file.
KEYCLOAK_THEMES_VOLUME=./clienti/admvetro/themes:/opt/client-themes:ro
KEYCLOAK_CMD=-b 0.0.0.0
